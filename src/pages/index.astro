---
import BaseLayout from '../layouts/BaseLayout.astro';
import PrismLayer from '../components/three/PrismLayer.astro';
import Nav from '../components/ui/Nav.astro';
import Hero from '../components/experience/Hero.astro';
import SceneBlock from '../components/experience/SceneBlock.astro';
import { renderableScenes } from '../lib/experience/graph';
import { SITE } from '../data/site';
---

<BaseLayout
  title="Publia — El mundo está cambiando. Tu negocio también puede cambiar las reglas."
  description="Red cooperativa de desarrollo: agentes de IA, infraestructura compartida, memberships en pesos mexicanos y formación práctica para negocios que quieren hacer más con menos."
  path="/"
>
  <PrismLayer />
  <Nav />

  <main id="contenido">
    <Hero />

    {
      renderableScenes().map((scene) => (
        <SceneBlock scene={scene} anchor={`escena-${scene.id.toLowerCase()}`} />
      ))
    }
  </main>

  <footer class="footer">
    <div class="shell footer__inner">
      <p class="footer__brand">PUBLIA</p>
      <div class="footer__contact">
        <p>
          <a class="footer__mail" href={`mailto:${SITE.email}`}>{SITE.email}</a>
          <span class="muted"> · {SITE.city}, {SITE.country}</span>
        </p>
        <ul class="footer__socials">
          {
            SITE.socials.map((social) => (
              <li>
                <a href={social.href} rel="noopener noreferrer" target="_blank">
                  {social.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </footer>

  <script>
    import '../scripts/experience';
  </script>
</BaseLayout>

<style>
  .footer {
    position: relative;
    z-index: 1;
    border-top: 1px solid var(--border-subtle);
    padding-block: var(--space-4);
    background: var(--ink-950);
  }

  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
  }

  .footer__brand {
    font-family: var(--font-display);
    letter-spacing: 0.22em;
    font-size: var(--step--1);
    margin: 0;
  }

  .footer p {
    margin: 0;
    max-width: 42ch;
    font-size: var(--step--1);
  }

  .footer__contact {
    display: grid;
    gap: var(--space-1);
  }

  .footer__mail {
    color: var(--scene-accent);
    text-underline-offset: 0.25em;
  }

  .footer__socials {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--step--1);
  }

  .footer__socials a {
    color: var(--ink-300);
    text-decoration: none;
  }

  .footer__socials a:hover {
    color: var(--paper);
  }
</style>
