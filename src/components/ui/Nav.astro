---
/**
 * Navegación principal. Es un header fijo, ligero y accesible por teclado.
 *
 * Los enlaces apuntan a escenas del grafo narrativo. "Cambiar de ruta" reinicia
 * el estado del visitante: el recorrido debe poder deshacerse en cualquier
 * momento (brief §7).
 */
---

<header class="nav">
  <div class="nav__inner shell">
    <a class="nav__brand" href="#inicio" aria-label="Publia, inicio">
      <span class="nav__mark" aria-hidden="true"></span>
      <span class="nav__word">PUBLIA</span>
    </a>

    <nav class="nav__links" aria-label="Secciones">
      <a href="#escena-e03">Empresa</a>
      <a href="#escena-e07">Eficiencia</a>
      <a href="#escena-e13">Explorar</a>
      <a href="#escena-e21">Infraestructura</a>
      <a href="#escena-e27">Membresías</a>
    </nav>

    <div class="nav__actions">
      <button type="button" class="nav__reset" data-route-reset>Cambiar de ruta</button>
      <a class="button button--small button--ghost nav__cta" href="#escena-e30">Conocernos</a>
    </div>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    backdrop-filter: blur(14px);
    background: color-mix(in oklab, var(--ink-950) 72%, transparent);
    border-bottom: 1px solid var(--border-subtle);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: 3.75rem;
  }

  .nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: 0.18em;
    font-size: var(--step--1);
  }

  .nav__mark {
    width: 0.85rem;
    height: 0.85rem;
    rotate: 45deg;
    background: linear-gradient(135deg, var(--scene-accent), var(--accent-strong));
    box-shadow: 0 0 22px -4px var(--scene-accent);
    transition: background var(--dur-base) var(--ease-out);
  }

  .nav__links {
    display: none;
    gap: var(--space-3);
    font-size: var(--step--1);
  }

  .nav__links a {
    text-decoration: none;
    color: var(--ink-200);
    padding: 0.35rem 0;
    border-bottom: 1px solid transparent;
    transition:
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }

  .nav__links a:hover,
  .nav__links a:focus-visible {
    color: var(--paper);
    border-color: var(--scene-accent);
  }

  @media (min-width: 1000px) {
    .nav__links {
      display: flex;
    }
  }

  .nav__actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .nav__reset {
    display: none;
    border: 1px solid var(--border-subtle);
    border-radius: 999px;
    background: transparent;
    color: var(--ink-200);
    font: inherit;
    font-size: var(--step--1);
    padding: 0.35rem 0.8rem;
    cursor: pointer;
    transition:
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }

  .nav__reset:hover,
  .nav__reset:focus-visible {
    color: var(--paper);
    border-color: var(--scene-accent);
  }

  /* El control sólo aparece cuando ya hay una ruta elegida. */
  html[data-route='enterprise'] .nav__reset,
  html[data-route='efficiency'] .nav__reset,
  html[data-route='explorer'] .nav__reset {
    display: inline-flex;
  }

  @media (max-width: 520px) {
    .nav__reset {
      display: inline-flex !important;
      padding: 0.3rem 0.6rem;
    }
  }

  .nav__cta {
    display: none;
  }

  @media (min-width: 640px) {
    .nav__cta {
      display: inline-flex;
    }
  }
</style>
