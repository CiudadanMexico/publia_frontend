---
/**
 * Navegación principal. Es un header fijo, ligero y accesible por teclado.
 *
 * Los enlaces apuntan a escenas del grafo narrativo. "Cambiar de ruta" reinicia
 * el estado del visitante: el recorrido debe poder deshacerse en cualquier
 * momento (brief §7).
 */
---

<header class="nav">
  <div class="nav__inner shell">
    <a class="nav__brand" href="#inicio" aria-label="Publia, inicio">
      <img
        class="nav__logo"
        src="/brand/publia-logo-header.png"
        width="560"
        height="322"
        alt="Publia"
        decoding="async"
      />
    </a>

    <nav class="nav__links" aria-label="Secciones">
      <a href="#escena-e03">Empresa</a>
      <a href="#escena-e07">Eficiencia</a>
      <a href="#escena-e13">Explorar</a>
      <a href="#escena-e21">Infraestructura</a>
      <a href="#escena-e27">Membresías</a>
    </nav>

    <div class="nav__actions">
      <button type="button" class="nav__back" data-act-back style="display: none">← Volver</button>
      <button type="button" class="nav__reset" data-route-reset>Cambiar de ruta</button>
      <a class="button button--small button--ghost nav__cta" href="#escena-e30">Conocernos</a>
    </div>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    backdrop-filter: blur(14px);
    background: color-mix(in oklab, var(--ink-950) 72%, transparent);
    border-bottom: 1px solid var(--border-subtle);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: 3.75rem;
  }

  .nav__brand {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }

  /* Logotipo oficial (la marca provisional tipográfica ya no se usa). */
  .nav__logo {
    display: block;
    height: 2.5rem;
    width: auto;
    filter: drop-shadow(0 2px 16px rgba(0, 191, 245, 0.35));
  }

  @media (max-width: 640px) {
    .nav__logo {
      height: 2rem;
    }
  }

  .nav__links {
    display: none;
    gap: var(--space-3);
    font-size: var(--step--1);
  }

  .nav__links a {
    text-decoration: none;
    color: var(--ink-200);
    padding: 0.35rem 0;
    border-bottom: 1px solid transparent;
    transition:
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }

  .nav__links a:hover,
  .nav__links a:focus-visible {
    color: var(--paper);
    border-color: var(--scene-accent);
  }

  @media (min-width: 1000px) {
    .nav__links {
      display: flex;
    }
  }

  .nav__actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .nav__back {
    display: none;
    border: 1px solid var(--border-subtle);
    border-radius: 999px;
    background: transparent;
    color: var(--ink-200);
    font: inherit;
    font-size: var(--step--1);
    padding: 0.35rem 0.8rem;
    cursor: pointer;
    transition:
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }

  .nav__back:hover,
  .nav__back:focus-visible {
    color: var(--paper);
    border-color: var(--scene-accent);
  }

  .nav__reset {
    display: none;
    border: 1px solid var(--border-subtle);
    border-radius: 999px;
    background: transparent;
    color: var(--ink-200);
    font: inherit;
    font-size: var(--step--1);
    padding: 0.35rem 0.8rem;
    cursor: pointer;
    transition:
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }

  .nav__reset:hover,
  .nav__reset:focus-visible {
    color: var(--paper);
    border-color: var(--scene-accent);
  }

  /* El control sólo aparece cuando ya hay una ruta elegida. */
  html[data-route='enterprise'] .nav__reset,
  html[data-route='efficiency'] .nav__reset,
  html[data-route='explorer'] .nav__reset {
    display: inline-flex;
  }

  @media (max-width: 520px) {
    .nav__reset {
      display: inline-flex !important;
      padding: 0.3rem 0.6rem;
    }
  }

  .nav__cta {
    display: none;
  }

  @media (min-width: 640px) {
    .nav__cta {
      display: inline-flex;
    }
  }
</style>
