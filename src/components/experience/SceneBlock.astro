---
/**
 * Escena del grafo narrativo.
 *
 * Dos capas de visibilidad para poder combinar condiciones con CSS puro
 * (y por tanto sin JavaScript):
 *  - capa externa: la ruta (compartida / empresa / eficiencia / exploración);
 *  - capa interna: los segmentos (rasgos y ruta) que la escena exige.
 */
import type { ResolvedScene } from '../../lib/experience/graph';
import StatementModule from './modules/StatementModule.astro';
import TextModule from './modules/TextModule.astro';
import NetworkModule from './modules/NetworkModule.astro';
import DemoModule from './modules/DemoModule.astro';
import CatalogModule from './modules/CatalogModule.astro';
import CtaModule from './modules/CtaModule.astro';
import FormModule from './modules/FormModule.astro';

interface Props {
  scene: ResolvedScene;
  /** Id de ancla estable para navegación. */
  anchor?: string;
}

const { scene, anchor } = Astro.props;
const anchorId = anchor ?? `escena-${scene.id.toLowerCase()}`;
const routeKey = scene.route === 'shared' ? 'shared' : scene.route;
const stageVariants = Object.fromEntries(
  (scene.variants ?? [])
    .filter((variant) => variant.route && variant.stage)
    .map((variant) => [variant.route as string, variant.stage as string]),
);
---

<section
  class="scene"
  id={anchorId}
  data-scene-id={scene.id}
  data-scene-route={routeKey}
  data-stage={scene.stage}
  data-palette={scene.palette}
  data-transition={scene.transition ?? 'fade'}
  data-variants={JSON.stringify(scene.variants ?? [])}
  data-pin={scene.effects?.pin ? String(scene.effects.pin) : undefined}
  data-depth={scene.effects?.depth ? String(scene.effects.depth) : undefined}
  data-parallax={scene.effects?.parallax ? String(scene.effects.parallax) : undefined}
  data-morph={scene.effects?.morph ? 'true' : undefined}
  data-stage-variants={Object.keys(stageVariants).length > 0 ? JSON.stringify(stageVariants) : undefined}
  style={`--scene-duration:${scene.duration}`}
  aria-labelledby={`${anchorId}-titulo`}
>
  <div
    class="scene__inner"
    data-scene-segments={scene.segments.length > 0 ? scene.segments.join(' ') : undefined}
  >
    <div class="scene__surface">
      <h2 class="visually-hidden" id={`${anchorId}-titulo`}>{scene.title}</h2>
      {
        scene.modules.map((module) => {
          if (module === 'statement' || module === 'branch') {
            return <StatementModule scene={scene} />;
          }
          if (module === 'split' || module === 'features') {
            return <TextModule scene={scene} />;
          }
          if (module === 'network' || module === 'infrastructure' || module === 'distribution') {
            return <NetworkModule scene={scene} />;
          }
          if (
            module === 'conversation' ||
            module === 'tasks' ||
            module === 'escalation' ||
            module === 'contentFlow'
          ) {
            return <DemoModule scene={scene} />;
          }
          if (module === 'plans' || module === 'catalog' || module === 'coverage') {
            return <CatalogModule scene={scene} />;
          }
          if (module === 'cta') {
            return <CtaModule scene={scene} />;
          }
          if (module === 'form') {
            return <FormModule scene={scene} />;
          }
          return null;
        })
      }
    </div>
  </div>
</section>
