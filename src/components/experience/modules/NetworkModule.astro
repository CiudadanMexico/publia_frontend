---
/**
 * Redes, nodos e infraestructura: `network`, `infrastructure`, `distribution`.
 * Todo es SVG procedimental: sin imágenes de stock.
 */
import type { ResolvedScene } from '../../../lib/experience/graph';
import { accentify } from '../../../lib/experience/accent';

interface Props {
  scene: ResolvedScene;
}

const { scene } = Astro.props;
const nodes = scene.data?.nodes ?? [];
const links = scene.data?.links ?? [];
const shares = scene.data?.shares ?? [];
const comparison = scene.data?.comparison;

// Disposición radial estable: los nodos de la red humana se ordenan en círculo.
const radius = 42;
const center = 50;
const positions = nodes.map((_, index) => {
  const angle = (index / Math.max(nodes.length, 1)) * Math.PI * 2 - Math.PI / 2;
  return {
    x: center + Math.cos(angle) * radius,
    y: center + Math.sin(angle) * radius,
  };
});
---

<section
  class="network-scene"
  data-module={scene.modules[0]}
  data-sticky={scene.effects?.sticky ? 'true' : undefined}
>
  <div class="network-scene__intro">
    {scene.eyebrow && <p class="network-scene__eyebrow" data-role="eyebrow" data-reveal set:html={accentify(scene.eyebrow)} />}
    <h2 class="network-scene__title" data-role="title" data-reveal="lines" set:html={accentify(scene.title)} />
    {scene.lead && <p class="network-scene__lead" data-role="lead" data-reveal>{scene.lead}</p>}
    {scene.body && <p class="network-scene__body" data-role="body" data-reveal>{scene.body}</p>}
  </div>

  {
    nodes.length > 0 && (
      <figure class="network" data-reveal>
        <svg viewBox="0 0 100 100" role="img" aria-label="Cadena de trabajo entre personas y agentes" class="network__svg">
          <g class="network__links">
            {links.map(([from, to], index) => {
              const a = positions[from];
              const b = positions[to];
              if (!a || !b) return null;
              return (
                <line
                  x1={a.x}
                  y1={a.y}
                  x2={b.x}
                  y2={b.y}
                  class="network__link"
                  style={`--delay:${index * 0.18}s`}
                />
              );
            })}
          </g>
          <g class="network__nodes">
            {nodes.map((node, index) => {
              const position = positions[index];
              if (!position) return null;
              return (
                <g class="network__node" style={`--delay:${index * 0.12}s`}>
                  <circle cx={position.x} cy={position.y} r="2.1" class="network__dot" />
                  <text x={position.x} y={position.y + 5.2} class="network__label" text-anchor="middle">
                    {node.label}
                  </text>
                  {node.role && (
                    <text x={position.x} y={position.y + 8.6} class="network__role" text-anchor="middle">
                      {node.role}
                    </text>
                  )}
                </g>
              );
            })}
          </g>
        </svg>
        <figcaption class="network__caption">
          La cadena real: la tecnología filtra y ejecuta; las personas deciden y responden.
        </figcaption>
      </figure>
    )
  }

  {
    comparison && (
      <div class="infra" data-reveal-group>
        <div class="infra__column infra__column--central" data-reveal>
          <h3 class="infra__heading">Concentrado</h3>
          <ul>
            {comparison.centralized.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
        <div class="infra__bridge" aria-hidden="true">
          <span class="infra__bridge-node" />
          <span class="infra__bridge-line" />
          <span class="infra__bridge-node infra__bridge-node--many" />
        </div>
        <div class="infra__column infra__column--distributed" data-reveal>
          <h3 class="infra__heading">Distribuido</h3>
          <ul>
            {comparison.distributed.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      </div>
    )
  }

  {
    shares.length > 0 && (
      <div class="shares" data-reveal-group>
        {shares.map((share, index) => (
          <div class="shares__row" data-reveal style={`--index:${index}`}>
            <div class="shares__bar" aria-hidden="true">
              <span class="shares__fill" style={`--value:${share.value}`} />
            </div>
            <div class="shares__meta">
              <strong class="shares__value">
                <span data-count={share.value} data-count-suffix="%">0%</span>
              </strong>
              <span class="shares__label">{share.label}</span>
              {share.note && <span class="shares__note">{share.note}</span>}
            </div>
          </div>
        ))}
      </div>
    )
  }
</section>
