---
/**
 * E22 Housing — 7M-H §6/§8. Este módulo posee el único H2 visible.
 * Modelo determinista de reparto (housingModel.ts): 100 unidades
 * ilustrativas, compartido 50/25/25 vs privado 100, caso inicial 85.
 * Entradas editables (cantidad 0–10, coste 1–100); dos columnas de salida
 * visibles a la vez; visual de 4 estaciones + rack segmentado; secuencia de
 * 6 s «Ver cómo se reparte el trabajo» con pausa/restablecer.
 */
import type { ResolvedScene } from '../../../lib/experience/graph';
import { COPY_7MF } from '../../../data/copy7mf';
import { E22_7MH } from '../../../data/copy7mh';
import { TASK_TYPES, SHARED_RESERVED } from '../../../lib/experience/housingModel';

interface Props {
  scene: ResolvedScene;
}

const { scene } = Astro.props;
const waBase = `https://wa.me/${COPY_7MF.contact.number}?text=`;
const e = E22_7MH;
---

<section class="housing7" data-demo="housing" data-housing>
  <div class="housing7__head">
    {scene.eyebrow && <p class="housing7__eyebrow" data-role="eyebrow" data-reveal>{scene.eyebrow}</p>}
    <h2 class="housing7__title" data-role="title" data-reveal>{scene.title}</h2>
    <p class="housing7__lead" data-role="lead" data-reveal>{scene.lead}</p>
    <p class="housing7__body" data-reveal>{scene.body}</p>
  </div>

  <p class="housing7__disclaimer" data-reveal>{e.disclaimer}</p>

  <div class="housing7__model" data-housing-model>
    <div class="housing7__inputs" role="group" aria-label="Entradas del escenario">
      <p class="housing7__inputs-cap">{e.capacityLabel}: <b>{e.capacityValue}</b> · {e.demandLabel}: <b data-housing-demand>85</b> unidades</p>
      <table class="housing7__table">
        <thead>
          <tr><th>Tipo de trabajo</th><th>Cantidad (0–10)</th><th>Unidades por tarea (1–100)</th><th>Prioridad</th></tr>
        </thead>
        <tbody>
          {TASK_TYPES.map((t) => (
            <tr data-housing-type={t.id}>
              <th scope="row">{t.label}</th>
              <td><input type="number" min="0" max="10" step="1" value={t.qty} data-housing-qty={t.id} inputmode="numeric" aria-label={`Cantidad de ${t.label}`} /></td>
              <td><input type="number" min="1" max="100" step="1" value={t.cost} data-housing-cost={t.id} inputmode="numeric" aria-label={`Unidades por tarea de ${t.label}`} /></td>
              <td>{t.priority}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <details class="housing7__assumptions">
        <summary>{e.assumptionsTitle}</summary>
        <p>{e.assumptions}</p>
      </details>
    </div>

    <div class="housing7__cols">
      <div class="housing7__col" data-housing-col="compartido">
        <h3>{e.colShared} <span class="housing7__cap">50 / 100</span></h3>
        <dl class="housing7__stats">
          <div><dt>{e.capClient}</dt><dd>50</dd></div>
          <div><dt>{e.capNetwork}</dt><dd>50 (25 socios y becarios · 25 miembros)</dd></div>
          <div><dt>{e.attended}</dt><dd data-hs="active">—</dd></div>
          <div><dt>{e.waiting}</dt><dd data-hs="waiting">—</dd></div>
          <div><dt>Unidades usadas</dt><dd data-hs="used">—</dd></div>
          <div><dt>Disponibles</dt><dd data-hs="available">—</dd></div>
        </dl>
        <ul class="housing7__counts" data-hs-counts></ul>
      </div>
      <div class="housing7__col" data-housing-col="privado">
        <h3>{e.colPrivate} <span class="housing7__cap">100 / 100</span></h3>
        <dl class="housing7__stats">
          <div><dt>{e.capClient}</dt><dd>100</dd></div>
          <div><dt>{e.capNetwork}</dt><dd>0</dd></div>
          <div><dt>{e.attended}</dt><dd data-hs="active">—</dd></div>
          <div><dt>{e.waiting}</dt><dd data-hs="waiting">—</dd></div>
          <div><dt>Unidades usadas</dt><dd data-hs="used">—</dd></div>
          <div><dt>Disponibles</dt><dd data-hs="available">—</dd></div>
        </dl>
        <ul class="housing7__counts" data-hs-counts></ul>
      </div>
    </div>

    <div class="housing7__controls">
      <div class="housing7__selector" role="group" aria-label="Elegir modalidad de Housing">
        <button class="housing7__mode" type="button" data-housing-mode="compartido" aria-pressed="true">Compartido</button>
        <button class="housing7__mode" type="button" data-housing-mode="privado" aria-pressed="false">Privado</button>
      </div>
      <button class="housing7__btn housing7__btn--primary" type="button" data-housing-run>{e.run}</button>
      <button class="housing7__btn" type="button" data-housing-pause aria-pressed="false" disabled>{e.pause}</button>
      <button class="housing7__btn" type="button" data-housing-reset>{e.reset}</button>
      <a class="housing7__btn housing7__btn--wa" data-housing-cta href={waBase} target="_blank" rel="noopener">Consultar mi Housing ↗</a>
    </div>
    <p class="housing7__status" data-housing-status role="status" aria-live="polite"></p>
  </div>

  <div class="housing7__stage" data-housing-stage data-mode="compartido">
    <div class="housing7__office">
      {e.stations.map((s, i) => (
        <div class="housing7__station" data-hstation={['calls', 'wa', 'docs', 'auto'][i]}>
          <span class="housing7__station-label">{s}</span>
          <div class="housing7__chips" data-hchips={['calls', 'wa', 'docs', 'auto'][i]}></div>
        </div>
      ))}
      <div class="housing7__rack" aria-hidden="true">
        <div class="housing7__rack-bar" data-hrack>
          <span class="housing7__rack-client" data-hrack-client style="width:50%"></span>
          <span class="housing7__rack-net" data-hrack-net style="width:50%"></span>
        </div>
        <p class="housing7__rack-label"><span data-hrack-label>50% negocio · 50% red</span></p>
        <div class="housing7__reserved" data-hreserved>
          {SHARED_RESERVED.map((r) => <span>{e.reservedDest}: {r.actor} {r.porcentaje}%</span>)}
        </div>
      </div>
    </div>
  </div>

  <div class="housing7__panels">
    <p data-housing-panel="compartido">{e.sharedPanel}</p>
    <p data-housing-panel="privado">{e.privatePanel}</p>
    <p class="housing7__below">{e.below}</p>
  </div>
</section>

<style>
  .housing7 { width: 100%; display: grid; gap: 28px; color: var(--scene-ink, #eef0f6); }
  .housing7__head { display: grid; max-width: 62ch; }
  .housing7__eyebrow { letter-spacing: 0.14em; text-transform: uppercase; font-size: 0.78rem; font-weight: 700; color: var(--scene-accent, #ffca34); margin: 0 0 12px; }
  .housing7__title { font-size: clamp(36px, 4.2vw, 64px); line-height: 1.08; font-weight: 800; margin: 0; letter-spacing: -0.02em; }
  .housing7__lead { margin: 16px 0 0; font-size: 20px; line-height: 1.4; font-weight: 600; }
  .housing7__body { margin: 12px 0 0; font-size: 16px; line-height: 1.6; max-width: 66ch; opacity: 0.85; }
  .housing7__disclaimer { margin: 0; font-size: 0.8rem; opacity: 0.7; font-style: italic; }

  .housing7__model { border: 1px solid var(--scene-border, rgba(255,255,255,0.14)); border-radius: 24px; padding: var(--panel-pad, 28px); display: grid; gap: 20px; background: rgba(255,255,255,0.03); }
  .housing7__inputs-cap { margin: 0 0 10px; font-size: 0.9rem; opacity: 0.85; }
  .housing7__table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
  .housing7__table th, .housing7__table td { text-align: left; padding: 8px 10px; border-bottom: 1px solid var(--scene-border, rgba(255,255,255,0.12)); }
  .housing7__table input { width: 100%; box-sizing: border-box; min-height: 44px; padding: 8px 10px; border-radius: 10px; border: 1px solid var(--scene-border, rgba(255,255,255,0.2)); background: rgba(255,255,255,0.06); color: inherit; font-size: 15px; }
  .housing7__table input:focus-visible { outline: 3px solid var(--scene-accent, #ffca34); outline-offset: 2px; }
  .housing7__assumptions { font-size: 0.84rem; }
  .housing7__assumptions summary { cursor: pointer; font-weight: 600; padding-inline-end: 32px; min-height: 28px; }
  .housing7__assumptions p { margin: 8px 0 0; opacity: 0.75; line-height: 1.5; }

  .housing7__cols { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .housing7__col { border: 1px solid var(--scene-border, rgba(255,255,255,0.14)); border-radius: 16px; padding: 16px; display: grid; gap: 10px; align-content: start; }
  .housing7__col h3 { margin: 0; font-size: 18px; display: flex; justify-content: space-between; gap: 8px; align-items: baseline; }
  .housing7__cap { font-size: 0.78rem; font-weight: 700; opacity: 0.7; }
  .housing7__col[data-active='true'] { border-color: var(--scene-accent, #ffca34); box-shadow: 0 0 0 1px var(--scene-accent, #ffca34); }
  .housing7__stats { margin: 0; display: grid; gap: 6px; }
  .housing7__stats div { display: flex; justify-content: space-between; gap: 10px; font-size: 0.86rem; }
  .housing7__stats dt { opacity: 0.75; }
  .housing7__stats dd { margin: 0; font-weight: 700; font-variant-numeric: tabular-nums; text-align: right; }
  .housing7__counts { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; font-size: 0.78rem; }
  .housing7__counts li { border: 1px solid var(--scene-border, rgba(255,255,255,0.16)); border-radius: 999px; padding: 3px 9px; }

  .housing7__controls { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
  .housing7__selector { display: flex; gap: 6px; border: 1px solid var(--scene-border, rgba(255,255,255,0.16)); border-radius: 999px; padding: 4px; }
  .housing7__mode { min-height: 40px; padding: 8px 14px; border-radius: 999px; border: 0; background: transparent; color: inherit; font-weight: 600; font-size: 14px; cursor: pointer; }
  .housing7__mode[aria-pressed='true'] { background: var(--scene-accent, #ffca34); color: #0a1730; }
  .housing7__mode:focus-visible { outline: 3px solid var(--scene-accent, #ffca34); outline-offset: 2px; }
  .housing7__btn { min-height: 44px; padding: 10px 16px; border-radius: 999px; border: 1px solid var(--scene-border, rgba(255,255,255,0.2)); background: transparent; color: inherit; font-weight: 600; font-size: 14px; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; }
  .housing7__btn--primary { background: var(--scene-accent, #ffca34); color: #0a1730; border-color: transparent; }
  .housing7__btn--wa { background: #25d366; color: #06121f; border-color: transparent; }
  .housing7__btn:focus-visible { outline: 3px solid #fff; outline-offset: 2px; }
  .housing7__btn[disabled] { opacity: 0.5; cursor: default; }
  .housing7__status { margin: 0; font-size: 0.85rem; opacity: 0.8; min-height: 1.2em; }

  .housing7__stage { border: 1px solid var(--scene-border, rgba(255,255,255,0.14)); border-radius: 24px; padding: var(--panel-pad, 28px); background: rgba(3, 13, 33, 0.55); }
  .housing7__office { display: grid; gap: 14px; }
  .housing7__station { display: grid; grid-template-columns: 130px 1fr; gap: 10px; align-items: center; }
  .housing7__station-label { font-size: 0.8rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; opacity: 0.85; }
  .housing7__chips { display: flex; flex-wrap: wrap; gap: 6px; min-height: 28px; }
  .housing7__chip { font-size: 0.76rem; font-weight: 700; border-radius: 999px; padding: 4px 10px; border: 1px solid var(--scene-border, rgba(255,255,255,0.2)); }
  .housing7__chip--on { background: rgba(37, 211, 102, 0.18); border-color: #25d366; color: #b9f4d4; }
  .housing7__chip--wait { opacity: 0.65; }
  .housing7__rack { border-top: 1px dashed var(--scene-border, rgba(255,255,255,0.2)); padding-top: 14px; display: grid; gap: 8px; }
  .housing7__rack-bar { display: flex; height: 16px; border-radius: 999px; overflow: hidden; background: rgba(255,255,255,0.08); }
  .housing7__rack-client { background: var(--scene-accent, #ffca34); display: block; transition: width 0.6s ease; }
  .housing7__rack-net { background: rgba(128, 229, 255, 0.55); display: block; transition: width 0.6s ease; }
  .housing7__rack-label { margin: 0; font-size: 0.8rem; opacity: 0.8; }
  .housing7__reserved { display: flex; gap: 8px; flex-wrap: wrap; font-size: 0.74rem; }
  .housing7__reserved span { border: 1px dashed rgba(128,229,255,0.6); color: #bfe9ff; border-radius: 999px; padding: 3px 9px; }
  .housing7__stage[data-mode='privado'] .housing7__reserved { display: none; }

  .housing7__panels { display: grid; gap: 10px; max-width: 75ch; }
  .housing7__panels p { margin: 0; line-height: 1.6; font-size: 0.95rem; opacity: 0.88; }
  .housing7__below { font-size: 0.85rem !important; opacity: 0.7 !important; }

  @media (max-width: 900px) {
    .housing7__cols { grid-template-columns: 1fr; }
    .housing7__station { grid-template-columns: 1fr; }
  }
</style>
