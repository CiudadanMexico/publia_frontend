---
/**
 * Formulario contextual de conversión.
 *
 * Reglas:
 * - El formulario **no captura nada en este sitio**: compone un mensaje
 *   estructurado y abre el cliente de correo del visitante. No hay servidor,
 *   ni base de datos, ni cookies de perfil.
 * - El contexto de navegación (ruta y rasgos) se añade automáticamente, para
 *   que la persona no tenga que repetir lo que ya nos dijo.
 * - Se piden los datos mínimos: correo (obligatorio), nombre (opcional),
 *   situación (selección) y mensaje (opcional).
 */
import type { ResolvedScene } from '../../../lib/experience/graph';

interface Props {
  scene: ResolvedScene;
}

const { scene } = Astro.props;

const situaciones = [
  { value: 'empresa-en-marcha', label: 'Empresa en marcha' },
  { value: 'negocio-en-arranque', label: 'Negocio en arranque' },
  { value: 'proyecto-puntual', label: 'Proyecto puntual' },
  { value: 'cooperativa', label: 'Cooperativa o red' },
  { value: 'infraestructura', label: 'Infraestructura o nodo' },
  { value: 'capacitacion', label: 'Capacitación' },
];
---

<section class="conversion-form" data-module="form" aria-labelledby={`${scene.id}-form-titulo`}>
  <h3 class="conversion-form__title" id={`${scene.id}-form-titulo`}>Cuéntanos en una línea</h3>
  <p class="conversion-form__lead">
    El mensaje se arma con lo que ya elegiste en este recorrido. Se abre en tu
    correo: este sitio no guarda lo que escribes.
  </p>

  <form class="conversion-form__form" data-context-form novalidate>
    <div class="conversion-form__row">
      <label class="conversion-form__field">
        <span class="conversion-form__label">Tu nombre <span class="conversion-form__optional">(opcional)</span></span>
        <input type="text" name="nombre" autocomplete="name" placeholder="Cómo te llamas" />
      </label>

      <label class="conversion-form__field">
        <span class="conversion-form__label">Correo <span class="conversion-form__required">(obligatorio)</span></span>
        <input type="email" name="correo" autocomplete="email" required placeholder="tu@correo.mx" />
      </label>
    </div>

    <label class="conversion-form__field">
      <span class="conversion-form__label">¿En qué punto estás?</span>
      <select name="situacion">
        {situaciones.map((item) => (
          <option value={item.value}>{item.label}</option>
        ))}
      </select>
    </label>

    <label class="conversion-form__field">
      <span class="conversion-form__label">¿Qué necesitas? <span class="conversion-form__optional">(opcional)</span></span>
      <textarea name="mensaje" rows="3" placeholder="Una o dos líneas bastan."></textarea>
    </label>

    <div class="conversion-form__actions">
      <button type="submit" class="button button--primary">Preparar mensaje</button>
      <p class="conversion-form__status" data-form-status role="status" aria-live="polite"></p>
    </div>

    <p class="conversion-form__legal">
      Al continuar se abrirá tu programa de correo con el mensaje escrito. No
      se almacena información en este sitio ni se envían datos a servidores de
      terceros. Si prefieres escribir directamente, usa
      <a href="mailto:hola@publia.mx">hola@publia.mx</a>.
    </p>
  </form>
</section>

<style>
  .conversion-form {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-3);
    padding: var(--space-3);
    border: 1px solid color-mix(in oklab, var(--scene-accent) 26%, transparent);
    border-radius: 1.25rem;
    background: color-mix(in oklab, var(--ink-900) 76%, transparent);
    max-width: 46rem;
  }

  .conversion-form__title {
    margin: 0;
    font-size: var(--step-1);
  }

  .conversion-form__lead {
    margin: 0;
    color: var(--ink-300);
    font-size: var(--step--1);
    max-width: 48ch;
  }

  .conversion-form__form {
    display: grid;
    gap: var(--space-2);
  }

  .conversion-form__row {
    display: grid;
    gap: var(--space-2);
  }

  @media (min-width: 640px) {
    .conversion-form__row {
      grid-template-columns: 1fr 1fr;
    }
  }

  .conversion-form__field {
    display: grid;
    gap: 0.35rem;
  }

  .conversion-form__label {
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    color: var(--ink-200);
  }

  .conversion-form__optional {
    color: var(--ink-300);
    letter-spacing: 0;
  }

  .conversion-form__required {
    color: var(--scene-accent);
    letter-spacing: 0;
  }

  .conversion-form__field input,
  .conversion-form__field select,
  .conversion-form__field textarea {
    width: 100%;
    padding: 0.7rem 0.8rem;
    border-radius: 0.75rem;
    border: 1px solid var(--border-subtle);
    background: color-mix(in oklab, var(--ink-950) 70%, transparent);
    color: var(--paper);
    font: inherit;
    font-size: var(--step-0);
  }

  .conversion-form__field textarea {
    resize: vertical;
  }

  .conversion-form__field input:focus-visible,
  .conversion-form__field select:focus-visible,
  .conversion-form__field textarea:focus-visible {
    outline: 2px solid var(--scene-accent);
    outline-offset: 2px;
  }

  .conversion-form__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }

  .conversion-form__status {
    margin: 0;
    font-size: var(--step--1);
    color: var(--scene-accent);
  }

  .conversion-form__status[data-state='error'] {
    color: #ff9b8a;
  }

  .conversion-form__legal {
    margin: 0;
    font-size: var(--step--1);
    color: var(--ink-300);
    max-width: 62ch;
  }

  .conversion-form__legal a {
    color: var(--scene-accent);
  }
</style>
