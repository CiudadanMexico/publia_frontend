---
/**
 * E30 Contacto — bloque 7M-F §9 (decisión cerrada).
 * Formulario: nombre obligatorio (máx 100), negocio opcional (máx 150; vacío
 * → «Sin especificar»), necesidad obligatoria (máx 1000). Con maxlength y
 * contador, sin truncar en silencio. Al enviar se abre el enlace REAL de
 * WhatsApp con contact.formMessage (placeholders sustituidos por selecciones
 * explícitas); nunca se afirma «mensaje enviado» ni se envía automáticamente.
 * Textos literales de copy.es-MX.json (`closing`).
 */
import type { ResolvedScene } from '../../../lib/experience/graph';
import { COPY_7MF } from '../../../data/copy7mf';

interface Props {
  scene: ResolvedScene;
}

const { scene } = Astro.props;
const c = COPY_7MF.closing;
const waBase = `https://wa.me/${COPY_7MF.contact.number}?text=`;
---

<section class="waf" data-module="form" data-wa-form aria-labelledby={`${scene.id}-form-titulo`}>
  <h3 class="waf__title" id={`${scene.id}-form-titulo`}>{c.title}</h3>
  <p class="waf__lead">{c.lead}</p>

  <form class="waf__form" data-wa-form-el novalidate>
    <label class="waf__field">
      <span class="waf__label">{c.name} *</span>
      <input type="text" name="nombre" autocomplete="name" required maxlength="100" placeholder={c.name} data-wa-nombre />
      <span class="waf__count" data-wa-count="nombre">0/100</span>
    </label>
    <label class="waf__field">
      <span class="waf__label">{c.business}</span>
      <input type="text" name="negocio" autocomplete="organization" maxlength="150" placeholder={c.business} data-wa-negocio />
      <span class="waf__count" data-wa-count="negocio">0/150</span>
    </label>
    <label class="waf__field">
      <span class="waf__label">{c.need} *</span>
      <textarea name="necesidad" rows="3" required maxlength="1000" placeholder={c.needPlaceholder} data-wa-necesidad></textarea>
      <span class="waf__count" data-wa-count="necesidad">0/1000</span>
    </label>
    <p class="waf__error" data-wa-error hidden role="alert">{c.error}</p>
    <div class="waf__actions">
      <a class="button button--primary waf__submit" data-wa-submit href={waBase} target="_blank" rel="noopener noreferrer">{c.submit} ↗</a>
      <p class="waf__privacy">{c.privacy}</p>
    </div>
  </form>
</section>

<style>
  .waf { display: grid; gap: 14px; margin-top: 24px; padding: 28px; border: 1px solid var(--scene-border, rgba(128,229,255,.25)); border-radius: 24px; max-width: 46rem; background: rgba(5,11,27,.45); }
  .waf__title { margin: 0; font-size: clamp(22px, 2vw, 30px); }
  .waf__lead { margin: 0; max-width: 58ch; line-height: 1.55; opacity: .9; }
  .waf__form { display: grid; gap: 14px; }
  .waf__field { display: grid; gap: 6px; position: relative; }
  .waf__label { font-size: .9rem; font-weight: 600; }
  .waf__field input, .waf__field textarea { min-height: 48px; padding: 12px 14px; font-size: 16px; border-radius: 12px; border: 1px solid var(--scene-border, rgba(128,229,255,.3)); background: rgba(3,8,20,.6); color: inherit; width: 100%; resize: vertical; }
  .waf__field input:focus-visible, .waf__field textarea:focus-visible { outline: 3px solid var(--scene-accent, #ffca34); outline-offset: 3px; }
  .waf__count { justify-self: end; font-size: .72rem; opacity: .6; }
  .waf__error { margin: 0; color: #fa5964; font-size: .9rem; }
  .waf__actions { display: grid; gap: 8px; justify-items: start; }
  .waf__submit { min-height: 48px; padding: 14px 22px; font-size: 16px; border-radius: 999px; text-decoration: none; display: inline-flex; align-items: center; }
  .waf__submit:focus-visible { outline: 3px solid var(--scene-accent, #ffca34); outline-offset: 3px; }
  .waf__privacy { margin: 0; font-size: .8rem; opacity: .7; max-width: 52ch; }
  @media (max-width: 639px) { .waf { padding: 20px; } }
</style>
