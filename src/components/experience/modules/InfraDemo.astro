---
/**
 * E03 Infraestructura — 7M-H §6/§7. Un solo H2 (este módulo lo posee):
 * «Soberanía digital.» blanco + «Tu tecnología, bajo tus reglas.» cian sobre
 * #020910. Stage 3D low-poly con 4 topologías distintas (infra3d.ts),
 * etiquetas HTML superpuestas, hotspots con copys literales, «Ver recorrido
 * de una tarea» + pausa, ruta alternativa en red distribuida. Panel 5/12 con
 * las 4 filas por modo (siempre visibles) + CTA + vínculo a E22 en Housing.
 * Los SVG quedan como detalle opcional «Ver esquema de conexiones».
 */
import type { ResolvedScene } from '../../../lib/experience/graph';
import { COPY_7MF } from '../../../data/copy7mf';
import { INFRA_ROWS_7MH, INFRA_STAGE_7MH, E03_TITLE_7MH } from '../../../data/copy7mh';
import svgPrivada from '../../../assets/7mf/infra_local_privada.svg?raw';
import svgColaborativa from '../../../assets/7mf/infra_local_colaborativa.svg?raw';
import svgHousing from '../../../assets/7mf/infra_housing.svg?raw';
import svgDistribuida from '../../../assets/7mf/infra_distribuida.svg?raw';

interface Props {
  scene: ResolvedScene;
}

const { scene } = Astro.props;
const infra = COPY_7MF.infra;
const modes = infra.modes;
const first = modes[0]!;
const rows = INFRA_ROWS_7MH[first.id] ?? [];
const svgById: Record<string, string> = {
  'local-private': svgPrivada,
  'local-collaborative': svgColaborativa,
  'managed-housing': svgHousing,
  'distributed-network': svgDistribuida,
};
const waBase = `https://wa.me/${COPY_7MF.contact.number}?text=`;
---

<section
  class="infra7"
  data-module="infraDemo"
  data-demo="infra2"
  data-infra7
  style={`--e03-bg:${E03_TITLE_7MH.bg};--e03-a:${E03_TITLE_7MH.line1Color};--e03-b:${E03_TITLE_7MH.line2Color};`}
>
  <div class="infra7__head">
    <h2 class="infra7__title" data-role="title" data-reveal>
      <span class="infra7__title-a">{E03_TITLE_7MH.line1}</span>
      <span class="infra7__title-b">{E03_TITLE_7MH.line2}</span>
    </h2>
    <p class="infra7__lead" data-role="lead" data-reveal>{scene.lead}</p>
    <p class="infra7__body" data-reveal>{scene.body}</p>
  </div>

  <p class="infra7__label" id="infra7-label">{infra.label}</p>
  <div class="infra7__modes" role="group" aria-labelledby="infra7-label">
    {
      modes.map((m, i) => (
        <button
          type="button"
          class="infra7__mode"
          data-infra7-mode={m.id}
          aria-pressed={i === 0 ? 'true' : 'false'}
        >
          {m.label}
        </button>
      ))
    }
  </div>

  <div class="infra7__grid">
    <div class="infra7__stage" data-infra7-stage>
      <canvas
        class="infra7__canvas"
        data-infra7-canvas
        role="img"
        aria-label={INFRA_STAGE_7MH.stageLabel}
      ></canvas>
      <div class="infra7__hotspots" data-infra7-hotspots></div>
      <div class="infra7__tags" data-infra7-tags aria-hidden="true"></div>
      <p class="infra7__tip" data-infra7-tip role="status"></p>
      <div class="infra7__stage-controls">
        <button type="button" class="infra7__ctl" data-infra7-run>{INFRA_STAGE_7MH.taskRun}</button>
        <button type="button" class="infra7__ctl" data-infra7-pause aria-pressed="false">{INFRA_STAGE_7MH.pause}</button>
        <button type="button" class="infra7__ctl" data-infra7-altroute hidden>{INFRA_STAGE_7MH.altRoute}</button>
      </div>
    </div>

    <div class="infra7__panel">
      <h3 class="infra7__panel-title" data-infra7-title>{first.title}</h3>
      <p class="infra7__panel-body" data-infra7-body>{first.body}</p>
      <dl class="infra7__rows" data-infra7-rows>
        {rows.map((r) => (
          <div class="infra7__row">
            <dt>{r.label}</dt>
            <dd>{r.text}</dd>
          </div>
        ))}
      </dl>
      <a class="infra7__compare" data-infra7-compare href="#escena-e22" hidden>
        {INFRA_STAGE_7MH.compareLink}
      </a>
      <a
        class="infra7__cta"
        data-infra7-cta
        href={`${waBase}${encodeURIComponent(`${infra.cta} — Infraestructura: ${first.label}`)}`}
        target="_blank"
        rel="noopener"
      >
        {infra.cta}
      </a>
      <details class="infra7__schemes" data-infra7-schemes>
        <summary>Ver esquema de conexiones</summary>
        <div class="infra7__scheme-stage" data-infra7-scheme-stage>
          {modes.map((m) => (
            <div class="infra7__svg" data-infra7-svg={m.id} set:html={svgById[m.id] ?? ''} />
          ))}
        </div>
      </details>
    </div>
  </div>
</section>

<style>
  .infra7 {
    --ink: #f4f7ff;
    --muted: #aebadd;
    --accent: #80e5ff;
    --border: rgba(128, 229, 255, 0.22);
    width: 100%;
    display: grid;
    gap: 24px;
    color: var(--ink);
  }
  .infra7__head { display: grid; max-width: 60ch; }
  /* 7M-H §6: H2 clamp(48px,5vw,80px), lh 1.04, peso 800, máx 22ch; línea 1 blanca, línea 2 cian */
  .infra7__title {
    font-size: clamp(48px, 5vw, 80px);
    line-height: 1.04;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin: 0;
    max-width: 22ch;
  }
  .infra7__title-a { display: block; color: var(--e03-a); }
  .infra7__title-b { display: block; color: var(--e03-b); }
  .infra7__lead { margin: 24px 0 0; font-size: 20px; line-height: 1.45; color: var(--ink); font-weight: 600; }
  .infra7__body { margin: 16px 0 0; font-size: 16px; line-height: 1.6; color: var(--muted); max-width: 62ch; }

  .infra7__label { font-size: 0.8rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); margin: 32px 0 8px; font-weight: 700; }
  .infra7__modes { display: flex; flex-wrap: wrap; gap: 8px; }
  .infra7__mode {
    min-height: 44px;
    padding: 10px 16px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--ink);
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
  }
  .infra7__mode[aria-pressed='true'] { background: var(--accent); color: #06121f; border-color: var(--accent); }
  .infra7__mode:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }

  .infra7__grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: var(--gap-x, 32px); align-items: start; }
  .infra7__stage {
    position: relative;
    min-height: 520px;
    border-radius: 24px;
    overflow: hidden;
    border: 1px solid var(--border);
    background: #0a1626; /* fondo petróleo */
  }
  .infra7__canvas { display: block; width: 100%; height: 100%; min-height: 520px; }
  .infra7__hotspots, .infra7__tags { position: absolute; inset: 0; pointer-events: none; }
  .infra7__hotspot {
    position: absolute;
    transform: translate(-50%, -50%);
    width: 22px; height: 22px;
    border-radius: 50%;
    border: 2px solid var(--accent);
    background: rgba(128, 229, 255, 0.25);
    cursor: pointer;
    pointer-events: auto;
    padding: 0;
  }
  .infra7__hotspot:focus-visible { outline: 3px solid #fff; outline-offset: 2px; }
  .infra7__tag {
    position: absolute;
    transform: translate(-50%, -50%);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #06121f;
    background: #ffd12e;
    border-radius: 999px;
    padding: 4px 10px;
    white-space: nowrap;
  }
  .infra7__tip {
    position: absolute;
    left: 12px; bottom: 12px; right: 12px;
    margin: 0;
    font-size: 0.8rem;
    color: #eaf6ff;
    background: rgba(6, 12, 28, 0.82);
    padding: 8px 12px;
    border-radius: 10px;
    pointer-events: none;
  }
  .infra7__tip:empty { display: none; }
  .infra7__stage-controls { position: absolute; top: 12px; right: 12px; display: flex; gap: 8px; flex-wrap: wrap; justify-content: flex-end; }
  .infra7__ctl {
    min-height: 40px;
    padding: 8px 14px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: rgba(6, 12, 28, 0.8);
    color: var(--ink);
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
  }
  .infra7__ctl[aria-pressed='true'] { background: var(--accent); color: #06121f; }
  .infra7__ctl:focus-visible { outline: 3px solid #fff; outline-offset: 2px; }

  .infra7__panel { border: 1px solid var(--border); border-radius: 24px; padding: var(--panel-pad, 28px); display: grid; gap: 14px; align-content: start; background: rgba(6, 12, 28, 0.45); }
  .infra7__panel-title { margin: 0; font-size: clamp(22px, 2.2vw, 30px); line-height: 1.15; font-weight: 800; }
  .infra7__panel-body { margin: 0; color: var(--muted); line-height: 1.55; font-size: 0.95rem; }
  .infra7__rows { margin: 0; display: grid; gap: 10px; }
  .infra7__row { display: grid; gap: 2px; border-top: 1px solid var(--border); padding-top: 10px; }
  .infra7__row dt { font-size: 0.76rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent); }
  .infra7__row dd { margin: 0; font-size: 0.92rem; line-height: 1.55; color: var(--ink); }
  .infra7__compare { color: var(--accent); font-size: 0.9rem; font-weight: 600; }
  .infra7__cta {
    min-height: 48px;
    padding: 14px 22px;
    font-size: 16px;
    font-weight: 700;
    border-radius: 999px;
    background: #ffd12e;
    color: #0a1730;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .infra7__cta:focus-visible { outline: 3px solid #fff; outline-offset: 3px; }
  .infra7__schemes { font-size: 0.85rem; }
  .infra7__schemes summary { cursor: pointer; font-weight: 600; color: var(--accent); min-height: 28px; padding-inline-end: 32px; }
  .infra7__schemes summary:focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }
  .infra7__scheme-stage { margin-top: 10px; display: grid; }
  .infra7__svg[hidden] { display: none; }
  .infra7__svg :global(svg) { width: 100%; height: auto; }

  @media (max-width: 1023px) {
    .infra7__grid { grid-template-columns: 1fr; }
    .infra7__stage { min-height: 420px; }
    .infra7__canvas { min-height: 420px; }
  }
  @media (max-width: 639px) {
    .infra7__stage { min-height: 320px; }
    .infra7__canvas { min-height: 320px; }
    .infra7__title { font-size: clamp(34px, 9vw, 44px); }
  }
</style>
