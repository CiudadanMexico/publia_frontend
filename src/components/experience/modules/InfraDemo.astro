---
/**
 * E03 Infraestructura — bloque 7M-F §7.
 * Cuatro escenarios con el SVG vectorial exacto incrustado (sin regenerar,
 * IDs conservados, aria-hidden=true), selector con aria-pressed, un solo SVG
 * visible en superficie 16:9, caption fuera del gráfico y CTA único dentro
 * del panel de explicación. Textos literales de copy.es-MX.json (`infra`).
 * Sin botón «Activar red», sin contador de tráfico ni porcentajes ilustrativos.
 */
import type { ResolvedScene } from '../../../lib/experience/graph';
import { accentify } from '../../../lib/experience/accent';
import { COPY_7MF } from '../../../data/copy7mf';
import svgPrivada from '../../../assets/7mf/infra_local_privada.svg?raw';
import svgColaborativa from '../../../assets/7mf/infra_local_colaborativa.svg?raw';
import svgHousing from '../../../assets/7mf/infra_housing.svg?raw';
import svgDistribuida from '../../../assets/7mf/infra_distribuida.svg?raw';

interface Props {
  scene: ResolvedScene;
}

const { scene } = Astro.props;
const infra = COPY_7MF.infra;
const modes = infra.modes;
const svgById: Record<string, string> = {
  'local-private': svgPrivada,
  'local-collaborative': svgColaborativa,
  'managed-housing': svgHousing,
  'distributed-network': svgDistribuida,
};
const first = modes[0]!;
const waBase = `https://wa.me/${COPY_7MF.contact.number}?text=`;
---

<section class="infra7" data-module="infraDemo" data-demo="infra2" data-infra7>
  <div class="infra7__head">
    <p class="infra7__eyebrow" data-reveal set:html={accentify(infra.eyebrow)} />
    <h2 class="infra7__title" data-role="title" data-reveal="lines" set:html={accentify(infra.title)} />
    <p class="infra7__lead" data-reveal>{infra.lead}</p>
  </div>

  <p class="infra7__label" id="infra7-label">{infra.label}</p>
  <div class="infra7__modes" role="group" aria-labelledby="infra7-label">
    {
      modes.map((m, i) => (
        <button
          type="button"
          class="infra7__mode"
          data-infra7-mode={m.id}
          aria-pressed={i === 0 ? 'true' : 'false'}
        >
          {m.label}
        </button>
      ))
    }
  </div>

  <div class="infra7__body">
    <div class="infra7__stage" data-infra7-stage data-mode={first.id} role="img" aria-label={first.alt}>
      {
        modes.map((m, i) => (
          <div class="infra7__svg" data-infra7-svg={m.id} hidden={i !== 0} aria-hidden="true" set:html={svgById[m.id]} />
        ))
      }
      <p class="infra7__caption" data-infra7-caption>{infra.caption}</p>
    </div>
    <div class="infra7__panel" data-infra7-panel aria-live="polite">
      <h3 data-infra7-title>{first.title}</h3>
      <p data-infra7-body>{first.body}</p>
      <p class="infra7__detail" data-infra7-detail>{first.detail}</p>
      <a
        class="button button--primary infra7__cta"
        data-infra7-cta
        href={`${waBase}${encodeURIComponent(COPY_7MF.contact.infraMessage.replace('{label}', first.label))}`}
        target="_blank"
        rel="noopener noreferrer"
      >
        {infra.cta}
      </a>
    </div>
  </div>
</section>

<style>
  .infra7 { display: grid; gap: 32px; }
  .infra7__eyebrow { letter-spacing: 0.14em; text-transform: uppercase; font-size: 0.78rem; color: var(--scene-accent, #80e5ff); margin: 0 0 12px; }
  .infra7__title { font-size: clamp(30px, 3.2vw, 56px); line-height: 1.08; margin: 0 0 16px; max-width: 22ch; }
  .infra7__lead { max-width: 58ch; font-size: 18px; line-height: 1.55; margin: 0; }
  .infra7__label { font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.1em; opacity: 0.8; margin: 8px 0 0; }
  .infra7__modes { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
  .infra7__mode {
    min-height: 48px; padding: 14px 18px; font-size: 16px; cursor: pointer; text-align: left;
    border: 1px solid var(--scene-border, rgba(128, 229, 255, 0.3)); border-radius: 16px;
    background: rgba(5, 11, 27, 0.5); color: inherit;
  }
  .infra7__mode[aria-pressed='true'] { background: var(--scene-accent, #80e5ff); color: #06121f; font-weight: 600; }
  .infra7__mode:focus-visible { outline: 3px solid var(--scene-accent, #ffca34); outline-offset: 3px; }
  .infra7__body { display: grid; grid-template-columns: repeat(12, 1fr); gap: 32px; align-items: start; }
  .infra7__stage { grid-column: 1 / 9; position: relative; aspect-ratio: 16 / 9; border: 1px solid var(--scene-border, rgba(128,229,255,.25)); border-radius: 24px; overflow: hidden; background: #101a35; }
  .infra7__svg { position: absolute; inset: 0; transition: opacity 180ms ease; }
  .infra7__svg[hidden] { display: block; opacity: 0; pointer-events: none; }
  .infra7__svg:not([hidden]) { opacity: 1; }
  .infra7__svg :global(svg) { display: block; width: 100%; height: 100%; }
  .infra7__caption { position: absolute; left: 16px; bottom: 12px; margin: 0; font-size: 0.78rem; color: #aebadd; background: rgba(6, 12, 28, 0.72); padding: 4px 10px; border-radius: 999px; }
  .infra7__panel { grid-column: 9 / 13; border: 1px solid var(--scene-border, rgba(128, 229, 255, 0.22)); border-radius: 24px; padding: 28px; display: grid; gap: 12px; align-content: start; }
  .infra7__panel h3 { margin: 0; font-size: clamp(22px, 2vw, 30px); line-height: 1.15; }
  .infra7__panel p { margin: 0; line-height: 1.55; }
  .infra7__detail { font-size: 0.9rem; opacity: 0.85; border-left: 3px solid var(--scene-accent, #80e5ff); padding-left: 12px; }
  .infra7__cta { min-height: 48px; padding: 14px 22px; font-size: 16px; border-radius: 999px; text-decoration: none; display: inline-flex; align-items: center; justify-content: center; }
  .infra7__cta:focus-visible { outline: 3px solid var(--scene-accent, #ffca34); outline-offset: 3px; }
  .infra7__stage[data-mode='local-private'] #private-flow-0,
  .infra7__stage[data-mode='local-private'] #private-flow-1,
  .infra7__stage[data-mode='local-private'] #private-flow-2 { stroke-dasharray: 12 10; animation: infra7-flow 2.8s linear infinite; }
  .infra7__stage[data-mode='local-collaborative'] #private-flow-0,
  .infra7__stage[data-mode='local-collaborative'] #private-flow-1 { stroke-dasharray: 12 10; animation: infra7-flow 2.8s linear infinite; }
  .infra7__stage[data-mode='local-collaborative'] #shared-service-flow,
  .infra7__stage[data-mode='local-collaborative'] #external-flow { stroke-dasharray: 12 10; animation: infra7-flow 3.6s linear infinite; }
  .infra7__stage[data-mode='managed-housing'] #business-flow { stroke-dasharray: 12 10; animation: infra7-flow 3s linear infinite; }
  .infra7__stage[data-mode='distributed-network'] #route-primary { animation: infra7-flow 4s linear infinite, infra7-route-primary 8s linear infinite; }
  .infra7__stage[data-mode='distributed-network'] #route-alternative { animation: infra7-route-alt 8s linear infinite; }
  @keyframes infra7-flow { to { stroke-dashoffset: -44; } }
  @keyframes infra7-route-primary { 0%, 50% { opacity: 1; } 50.01%, 100% { opacity: 0.45; } }
  @keyframes infra7-route-alt { 0%, 49.9% { opacity: 0.45; } 50%, 100% { opacity: 1; } }
  .infra7.is-paused [data-infra7-svg] * { animation-play-state: paused !important; }
  @media (prefers-reduced-motion: reduce) {
    .infra7__stage [data-infra7-svg] * { animation: none !important; }
    .infra7__svg { transition: none; }
  }
  @media (max-width: 1023px) {
    .infra7__modes { grid-template-columns: 1fr 1fr; gap: 12px; }
    .infra7__body { grid-template-columns: 1fr; gap: 24px; }
    .infra7__stage, .infra7__panel { grid-column: auto; }
    .infra7__panel { padding: 20px; }
  }
  @media (max-width: 639px) {
    .infra7 { gap: 24px; }
    .infra7__modes { grid-template-columns: 1fr 1fr; gap: 10px; }
    .infra7__lead { font-size: 16px; }
  }
</style>
