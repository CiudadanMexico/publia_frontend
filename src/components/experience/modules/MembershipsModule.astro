---
/**
 * Membresías configurables (P0-06, Bloque D 7M-B): 5 niveles desde la fuente
 * canónica src/data/memberships/. Identidad amarilla. Diagnóstico breve de
 * 2 preguntas recomienda un nivel; la selección persiste en state.membership.
 * AGENTE muestra su rango como objetivo pendiente, nunca como tarifa confirmada.
 */
import type { ResolvedScene } from '../../../lib/experience/graph';
import { accentify } from '../../../lib/experience/accent';
import { MEMBERSHIPS } from '../../../data/memberships';

interface Props {
  scene: ResolvedScene;
}

const { scene } = Astro.props;
const plans = MEMBERSHIPS;
const fmtPrice = (p: (typeof plans)[number]['price']): string =>
  p.priceConfirmed && p.priceFrom != null
    ? `$${p.priceFrom.toLocaleString('es-MX')} MXN/mes`
    : `pendiente de confirmar${p.priceFrom != null ? ` (objetivo $${p.priceFrom.toLocaleString('es-MX')}${p.priceTo != null && p.priceTo !== p.priceFrom ? `–$${p.priceTo.toLocaleString('es-MX')}` : ''} MXN/mes)` : ''}`;
const goals = [
  { id: 'start', label: '🌱 Empezar con web y atención' },
  { id: 'agent', label: '🤖 Un asistente de IA personal' },
  { id: 'growth', label: '📣 Marketing y automatización' },
  { id: 'support', label: '🤝 Acompañamiento humano' },
  { id: 'infrastructure', label: '🖥️ Infraestructura propia' },
] as const;
const teams = [
  { id: 'solo', label: '👤 Por mi cuenta' },
  { id: 'small', label: '👥 Con un equipo' },
  { id: 'large', label: '🏢 Operación grande' },
] as const;
const first = plans[0]!;
---

<section class="memb" data-module="membershipsDemo" data-demo="memberships">
  <div class="catalog__intro">
    {scene.eyebrow && <p class="catalog__eyebrow" data-reveal set:html={accentify(scene.eyebrow)} />}
    <h2 class="catalog__title" data-role="title" data-reveal="lines" set:html={accentify(scene.title)} />
    {scene.lead && <p class="catalog__lead" data-reveal>{scene.lead}</p>}
  </div>

  <div class="memb__grid">
    <div class="memb__core-wrap">
      <div class="memb__core" data-memb-core>
        <img src="/assets/ecosistema/publia_isotipo.png" alt="" />
        <span>TU NÚCLEO PUBLIA</span>
      </div>
      <div class="memb__chips" data-memb-chips>
        {plans.map((p) => <span class="memb__chip" data-memb-chip={p.slug}>{p.name}</span>)}
      </div>
    </div>

    <div class="memb__panel">
      <div class="memb__plans" role="group" aria-label="Niveles de membresía">
        <p class="memb__chosen" data-memb-chosen aria-live="polite">Tu selección: BASE (aún no confirmas un plan)</p>
        {plans.map((p, i) => (
          <button type="button" class="memb__plan" data-memb-plan={p.slug} aria-pressed={i === 0 ? 'true' : 'false'}>
            <strong>{p.name}</strong>
            <b>{fmtPrice(p.price)}</b>
            <span class="memb__badge" data-memb-badge={p.slug} hidden>Nuestra sugerencia</span>
          </button>
        ))}
      </div>
      <article class="memb__detail" aria-live="polite">
        <h3 data-memb-name>{first.name}</h3>
        <p data-memb-summary>{first.summary}</p>
        <p class="memb__price" data-memb-price>{fmtPrice(first.price)}</p>
        {first.price.priceConfirmed === false && first.price.pending && (
          <p class="memb__pending" data-memb-pending>{first.price.pending}</p>
        )}
        <div class="memb__feat-cols">
          <div>
            <h4>Incluye</h4>
            <ul data-memb-includes>{first.features.filter((f) => f.kind === 'incluye').map((f) => <li>{f.label}{f.confirmed ? '' : ' *'}</li>)}</ul>
          </div>
          <div>
            <h4>No incluye / condiciones</h4>
            <ul data-memb-excludes>{first.features.filter((f) => f.kind !== 'incluye').map((f) => <li>{f.label}{f.confirmed ? '' : ' *'}</li>)}</ul>
          </div>
        </div>
        {first.serviceWindow && (
          <p class="memb__window" data-memb-window>Ventana confirmada: {first.serviceWindow.start}–{first.serviceWindow.end} h{first.serviceWindow.note ? ` · ${first.serviceWindow.note}` : ''}</p>
        )}
        {first.laborysMonthly == null && <p class="memb__pending">Cantidad mensual de Laborys: pendiente de definir.</p>}
        <p class="memb__fine">* Alcance, cantidades, horarios y condiciones por confirmar. El chatbot de WhatsApp no es un agente personal; la atención humana no equivale a un empleado exclusivo.</p>
      </article>
    </div>
  </div>

  <div class="memb__diag">
    <h3>✨ Diagnóstico breve: tu punto de partida</h3>
    <div class="memb__diag-grid">
      <div>
        <span class="memb__q">¿Qué quieres lograr primero?</span>
        <div class="memb__opts" role="group" aria-label="Objetivo">
          {goals.map((g) => <button type="button" class="memb__opt" data-memb-goal={g.id} aria-pressed="false">{g.label}</button>)}
        </div>
      </div>
      <div>
        <span class="memb__q">¿Cómo trabajas?</span>
        <div class="memb__opts" role="group" aria-label="Equipo">
          {teams.map((t) => <button type="button" class="memb__opt" data-memb-team={t.id} aria-pressed="false">{t.label}</button>)}
        </div>
      </div>
    </div>
    <button type="button" class="memb__reco-btn" data-memb-recommend>✨ Ver mi punto de partida ↗</button>
    <div class="memb__reco" data-memb-reco hidden aria-live="polite">
      <p data-memb-reco-text></p>
      <button type="button" class="memb__reco-choose" data-memb-choose hidden>✓ Elegir este plan</button>
    </div>
  </div>
</section>

<style>
  .memb { display: grid; gap: 1.2rem; }
  .memb__chosen { margin: 0 0 8px; font-size: 12px; font-weight: 800; color: #7a5b00; letter-spacing: 0.04em; }
  .memb__plan { position: relative; }
  .memb__plan.is-suggested { outline: 2px dashed #b8860b; outline-offset: 2px; }
  .memb__badge { position: absolute; top: -9px; right: 8px; background: #ffe9a8; color: #7a5b00; border-radius: 100px; padding: 2px 8px; font-size: 9px; font-weight: 900; letter-spacing: 0.08em; }
  .memb__reco { margin-top: 10px; }
  .memb__reco p { margin: 0 0 8px; }
  .memb__reco-choose { border: 1px solid #7a5b00; background: #ffd64d; color: #3a2c00; border-radius: 100px; padding: 8px 14px; font-size: 11px; font-weight: 900; cursor: pointer; }
  .memb__grid { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.2fr); gap: 1.2rem; align-items: center; }
  .memb__core-wrap { display: grid; justify-items: center; gap: 1rem; }
  .memb__core { width: 120px; height: 120px; border-radius: 50%; display: grid; place-items: center; align-content: center; gap: 0.3rem; background: linear-gradient(135deg, #3ac8f6, #1061a8 55%, #0b3457); border: 6px solid #ffd12e; box-shadow: 0 10px 34px rgba(7, 26, 49, .25); }
  .memb__core img { width: 56px; height: 56px; object-fit: contain; }
  .memb__core span { font-size: 0.55rem; letter-spacing: .14em; font-weight: 900; color: #fff; }
  .memb__chips { display: flex; flex-wrap: wrap; gap: 0.4rem; justify-content: center; max-width: 320px; }
  .memb__chip { font-size: 0.66rem; font-weight: 800; letter-spacing: .06em; border-radius: 999px; padding: 0.3rem 0.7rem; background: rgba(255, 255, 255, .55); border: 1px solid #e8cf8e; color: #8a6d1a; opacity: .45; transition: all .3s; }
  .memb__chip.is-on { opacity: 1; background: #ffd12e; color: #071a31; border-color: #f7b814; box-shadow: 0 4px 14px rgba(247, 184, 20, .45); }
  .memb__panel { display: grid; gap: 0.8rem; border-radius: 1.2rem; background: rgba(255, 249, 235, .85); border: 1px solid #f0dcae; padding: 1rem; }
  .memb__plans { display: grid; grid-template-columns: repeat(5, 1fr); gap: 0.4rem; }
  .memb__plan { border: 1px solid #e8cf8e; background: #fffdf3; border-radius: 0.8rem; padding: 0.5rem 0.4rem; cursor: pointer; text-align: center; color: #132b44; transition: all .25s; }
  .memb__plan strong { display: block; font-size: 0.78rem; letter-spacing: .05em; }
  .memb__plan b { font-size: 0.66rem; color: #8a6d1a; font-weight: 800; }
  .memb__plan[aria-pressed='true'] { background: #ffd12e; border-color: #f7b814; box-shadow: 0 6px 18px rgba(247, 184, 20, .4); }
  .memb__plan[aria-pressed='true'] b { color: #071a31; }
  .memb__detail h3 { margin: 0; font-size: 1.15rem; color: #071a31; }
  .memb__detail > p { margin: 0.2rem 0; font-size: 0.88rem; color: #576678; line-height: 1.45; }
  .memb__price { font-weight: 900; color: #071a31 !important; font-size: 1rem !important; }
  .memb__pending { color: #b4530a !important; font-size: 0.8rem !important; }
  .memb__feat-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 0.7rem; }
  .memb__feat-cols h4 { margin: 0 0 0.25rem; font-size: 0.7rem; letter-spacing: .1em; text-transform: uppercase; color: #8a6d1a; }
  .memb__feat-cols ul { margin: 0; padding-left: 1.05rem; font-size: 0.8rem; color: #132b44; line-height: 1.45; display: grid; gap: 0.2rem; }
  .memb__window { font-size: 0.8rem !important; color: #0b6e4f !important; font-weight: 700; }
  .memb__fine { font-size: 0.72rem !important; color: #8a8272 !important; }
  .memb__diag { border-radius: 1.2rem; background: rgba(255, 249, 235, .85); border: 1px solid #f0dcae; padding: 1rem; display: grid; gap: 0.7rem; }
  .memb__diag h3 { margin: 0; color: #071a31; font-size: 1rem; }
  .memb__diag-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.9rem; }
  .memb__q { display: block; font-size: 0.75rem; font-weight: 800; letter-spacing: .08em; color: #576678; margin-bottom: 0.4rem; }
  .memb__opts { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .memb__opt { border: 1px solid #e8cf8e; background: #fffdf3; color: #132b44; border-radius: 999px; padding: 0.4rem 0.8rem; font-weight: 700; font-size: 0.8rem; cursor: pointer; }
  .memb__opt[aria-pressed='true'] { background: #142c56; color: #fff; border-color: transparent; }
  .memb__reco-btn { justify-self: start; border: none; border-radius: 999px; padding: 0.6rem 1.1rem; font-weight: 900; background: #ffcc2e; color: #11274e; cursor: pointer; box-shadow: 0 4px 0 rgba(222, 152, 76, .22); }
  .memb__reco { margin: 0; font-size: 0.9rem; color: #071a31; background: #ffd12e; border-radius: 0.7rem; padding: 0.6rem 0.9rem; font-weight: 700; }
  @media (max-width: 900px) {
    .memb__grid, .memb__diag-grid, .memb__feat-cols { grid-template-columns: 1fr; }
    .memb__plans { grid-template-columns: repeat(2, 1fr); }
  }
</style>
