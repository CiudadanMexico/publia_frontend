---
/**
 * E27 Membresías — bloque 7M-F §10.
 * Una sola fuente comercial: copy.es-MX.json (`memberships.plans`), usada
 * también por el resumen (E29) y la exportación. Cada tarjeta: nombre,
 * precio MXN/mes, tagline, features, «Ver alcance» (details que abre ANTES
 * de contactar) y CTA a WhatsApp con contact.planMessage. Sin cupos
 * ilimitados, tiempos garantizados ni montos no definidos.
 */
import type { ResolvedScene } from '../../../lib/experience/graph';
import { accentify } from '../../../lib/experience/accent';
import { COPY_7MF } from '../../../data/copy7mf';

interface Props {
  scene: ResolvedScene;
}

const { scene } = Astro.props;
const m = COPY_7MF.memberships;
const waBase = `https://wa.me/${COPY_7MF.contact.number}?text=`;
const fmt = (n: number): string => `$${n.toLocaleString('es-MX')}`;
---

<section class="memb7" data-module="membershipsDemo" data-demo="memberships" data-memb7>
  <div class="catalog__intro">
    <p class="catalog__eyebrow" data-reveal set:html={accentify(m.title)} />
    <h2 class="catalog__title" data-role="title" data-reveal="lines" set:html={accentify(m.title)} />
    <p class="catalog__lead" data-reveal>{m.lead}</p>
    <p class="memb7__shared">{m.sharedNote}</p>
  </div>

  <div class="memb7__grid">
    {
      m.plans.map((p) => (
        <article class="memb7__card" data-memb7-card={p.id}>
          <h3>{p.label}</h3>
          <p class="memb7__price">
            {fmt(p.priceMXN)} <small>{m.currency}</small>
          </p>
          <p class="memb7__tagline">{p.tagline}</p>
          <ul>
            {p.features.map((f) => (
              <li>{f}</li>
            ))}
          </ul>
          <details class="memb7__scope" data-memb7-scope={p.id}>
            <summary>{m.detailLabel}</summary>
            <p>{p.detail}</p>
          </details>
          <a
            class="button button--primary memb7__cta"
            data-memb7-cta={p.id}
            href={`${waBase}${encodeURIComponent(COPY_7MF.contact.planMessage.replace('{label}', p.label))}`}
            target="_blank"
            rel="noopener noreferrer"
          >
            {m.cta}
          </a>
        </article>
      ))
    }
  </div>

  <div class="memb7__extras">
    <h3>{m.extrasTitle}</h3>
    <p>{m.extrasBody}</p>
  </div>
</section>

<style>
  .memb7 { display: grid; gap: 32px; }
  .memb7__shared { max-width: 58ch; font-size: 0.9rem; opacity: 0.8; margin: 8px 0 0; }
  .memb7__grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 20px; align-items: stretch; }
  .memb7__card { border: 1px solid var(--scene-border, rgba(128,229,255,.25)); border-radius: 24px; padding: 28px 20px; display: grid; gap: 10px; align-content: start; background: rgba(5,11,27,.45); }
  .memb7__card h3 { margin: 0; font-size: 1.25rem; }
  .memb7__price { margin: 0; font-size: 1.6rem; font-weight: 700; font-variant-numeric: tabular-nums; }
  .memb7__price small { font-size: 0.8rem; font-weight: 500; opacity: 0.75; }
  .memb7__tagline { margin: 0; font-size: 0.92rem; opacity: 0.9; }
  .memb7__card ul { margin: 0; padding-left: 1.1rem; display: grid; gap: 6px; font-size: 0.88rem; line-height: 1.45; }
  .memb7__scope { border-top: 1px solid var(--scene-border, rgba(128,229,255,.18)); padding-top: 10px; }
  .memb7__scope summary { cursor: pointer; min-height: 28px; font-size: 0.9rem; font-weight: 600; color: var(--scene-accent, #80e5ff); }
  .memb7__scope summary:focus-visible { outline: 3px solid var(--scene-accent, #ffca34); outline-offset: 3px; }
  .memb7__scope p { margin: 8px 0 0; font-size: 0.85rem; line-height: 1.5; opacity: 0.9; }
  .memb7__cta { min-height: 48px; padding: 14px 22px; font-size: 16px; border-radius: 999px; text-decoration: none; display: inline-flex; align-items: center; justify-content: center; margin-top: auto; }
  .memb7__cta:focus-visible { outline: 3px solid var(--scene-accent, #ffca34); outline-offset: 3px; }
  .memb7__extras { border: 1px solid var(--scene-border, rgba(128,229,255,.2)); border-radius: 24px; padding: 28px; }
  .memb7__extras h3 { margin: 0 0 8px; font-size: clamp(22px, 2vw, 30px); }
  .memb7__extras p { margin: 0; max-width: 58ch; line-height: 1.55; }
  @media (max-width: 1279px) { .memb7__grid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 1023px) { .memb7__grid { grid-template-columns: repeat(2, 1fr); gap: 16px; } .memb7__card { padding: 20px; } }
  @media (max-width: 639px) { .memb7 { gap: 24px; } .memb7__grid { grid-template-columns: 1fr; } }
</style>
