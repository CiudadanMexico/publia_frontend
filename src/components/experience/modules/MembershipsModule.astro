---
/**
 * E27 Membresías — 7M-G: se restaura la estructura/interacción previa
 * (núcleo + chips + 5 selectores + panel de detalle + diagnóstico de 2
 * preguntas) con los datos comerciales de COPY_7MF.memberships.plans.
 * El selector guarda la selección y NO abre WhatsApp; el CTA separado
 * «Conversar sobre este plan» usa contact.planMessage. Eyebrow único.
 */
import type { ResolvedScene } from '../../../lib/experience/graph';
import { accentify } from '../../../lib/experience/accent';
import { COPY_7MF } from '../../../data/copy7mf';

interface Props {
  scene: ResolvedScene;
}

const { scene } = Astro.props;
const m = COPY_7MF.memberships;
const waBase = `https://wa.me/${COPY_7MF.contact.number}?text=`;
const fmt = (n: number): string => `$${n.toLocaleString('es-MX')}`;
const first = m.plans[0]!;
const goals = [
  { id: 'start', label: 'Mi sitio y la atención a clientes' },
  { id: 'agent', label: 'Un asistente personal' },
  { id: 'growth', label: 'Contenido y presencia digital' },
  { id: 'support', label: 'Acompañamiento humano' },
  { id: 'infrastructure', label: 'Infraestructura para mi negocio' },
] as const;
const teams = [
  { id: 'solo', label: 'Por mi cuenta' },
  { id: 'small', label: 'Con un equipo' },
  { id: 'large', label: 'Con una operación amplia' },
] as const;
---

<section class="memb" data-module="membershipsDemo" data-demo="memberships" data-memb7>
  <div class="catalog__intro">
    <p class="catalog__eyebrow" data-reveal>MEMBRESÍAS PUBLIA</p>
    <h2 class="catalog__title" data-role="title" data-reveal="lines" set:html={accentify(m.title)} />
    <p class="catalog__lead" data-reveal>{m.lead}</p>
    <p class="memb__shared">{m.sharedNote}</p>
  </div>

  <div class="memb__grid">
    <div class="memb__core-wrap">
      <div class="memb__core" data-memb-core>
        <img src="/assets/ecosistema/publia_isotipo.png" alt="" />
        <span>TU NÚCLEO PUBLIA</span>
      </div>
      <div class="memb__chips" data-memb-chips>
        {m.plans.map((p) => <span class="memb__chip" data-memb-chip={p.id}>{p.label}</span>)}
      </div>
    </div>

    <div class="memb__panel">
      <p class="memb__chosen" data-memb-chosen aria-live="polite">Tu selección: {first.label} (aún no confirmas un plan)</p>
      <div class="memb__plans" role="group" aria-label="Niveles de membresía">
        {m.plans.map((p, i) => (
          <div class="memb__plan-wrap">
            <button type="button" class="memb__plan" data-memb-plan={p.id} aria-pressed={i === 0 ? 'true' : 'false'}>
              <strong>{p.label}</strong>
              <b>{fmt(p.priceMXN)} {m.currency}</b>
              <span class="memb__badge" data-memb-badge={p.id} hidden>Sugerencia</span>
            </button>
            <details class="memb__scope" data-memb-scope={p.id}>
              <summary>{m.detailLabel}</summary>
              <p>{p.detail}</p>
            </details>
          </div>
        ))}
      </div>
      <article class="memb__detail" aria-live="polite">
        <h3 data-memb-name>{first.label}</h3>
        <p class="memb__price" data-memb-price>{fmt(first.priceMXN)} {m.currency}</p>
        <p data-memb-summary>{first.tagline}</p>
        <ul data-memb-includes>{first.features.map((f) => <li>{f}</li>)}</ul>
      </article>
      <a
        class="button button--primary memb__cta"
        data-memb7-cta={first.id}
        href={`${waBase}${encodeURIComponent(COPY_7MF.contact.planMessage.replace('{label}', first.label))}`}
        target="_blank"
        rel="noopener noreferrer"
      >
        Conversar sobre este plan
      </a>
    </div>
  </div>

  <div class="memb__diag">
    <h3>Encuentra tu punto de partida.</h3>
    <div class="memb__diag-grid">
      <div>
        <span class="memb__q">¿Qué quieres resolver primero?</span>
        <div class="memb__opts" role="group" aria-label="¿Qué quieres resolver primero?">
          {goals.map((g) => <button type="button" class="memb__opt" data-memb-goal={g.id} aria-pressed="false">{g.label}</button>)}
        </div>
      </div>
      <div>
        <span class="memb__q">¿Cómo trabajas?</span>
        <div class="memb__opts" role="group" aria-label="¿Cómo trabajas?">
          {teams.map((t) => <button type="button" class="memb__opt" data-memb-team={t.id} aria-pressed="false">{t.label}</button>)}
        </div>
      </div>
    </div>
    <button type="button" class="memb__reco-btn" data-memb-recommend>Ver mi punto de partida</button>
    <div class="memb__reco" data-memb-reco hidden aria-live="polite">
      <p data-memb-reco-text></p>
      <p class="memb__reco-note" data-memb-reco-note hidden>Puedes comparar los planes y elegir otro. Esta sugerencia no cambia tu selección.</p>
      <div class="memb__reco-actions">
        <button type="button" class="memb__reco-choose" data-memb-choose hidden>Elegir este plan</button>
        <a class="memb__reco-housing" data-memb-housing href="#escena-e22" hidden>Ver opciones de Housing</a>
      </div>
    </div>
  </div>

  <div class="memb__extras">
    <h3>{m.extrasTitle}</h3>
    <p>{m.extrasBody}</p>
  </div>
</section>

<style>
  .memb { display: grid; gap: 1.2rem; color: #091b34; }
  .memb .catalog__eyebrow, .memb .catalog__title, .memb .catalog__lead { color: #091b34; }
  .memb__shared { max-width: 58ch; font-size: 0.9rem; color: #5c4a12; margin: 8px 0 0; }
  .memb__chosen { margin: 0 0 8px; font-size: 12px; font-weight: 800; color: #7a5b00; letter-spacing: 0.04em; }
  .memb__plan-wrap { display: grid; gap: 4px; }
  .memb__plan { position: relative; min-height: 48px; }
  .memb__plan.is-suggested { outline: 2px dashed #b8860b; outline-offset: 2px; }
  .memb__badge { position: absolute; top: -9px; right: 8px; background: #ffe9a8; color: #7a5b00; border-radius: 100px; padding: 2px 8px; font-size: 9px; font-weight: 900; letter-spacing: 0.08em; }
  .memb__reco { margin-top: 10px; }
  .memb__reco p { margin: 0 0 8px; }
  .memb__reco-note { font-weight: 400; font-size: 0.82rem; }
  .memb__reco-actions { display: flex; gap: 0.6rem; flex-wrap: wrap; align-items: center; }
  .memb__reco-choose { border: 1px solid #7a5b00; background: #ffd64d; color: #3a2c00; border-radius: 100px; padding: 8px 14px; font-size: 11px; font-weight: 900; cursor: pointer; min-height: 48px; }
  .memb__reco-housing { color: #11274e; font-weight: 800; font-size: 0.85rem; min-height: 48px; display: inline-flex; align-items: center; }
  .memb__grid { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: 1.2rem; align-items: start; }
  .memb__core-wrap { display: grid; justify-items: center; gap: 1rem; }
  .memb__core { width: 120px; height: 120px; border-radius: 50%; display: grid; place-items: center; align-content: center; gap: 0.3rem; background: linear-gradient(135deg, #3ac8f6, #1061a8 55%, #0b3457); border: 6px solid #ffd12e; box-shadow: 0 10px 34px rgba(7, 26, 49, .25); transition: box-shadow .3s; }
  .memb__core img { width: 56px; height: 56px; object-fit: contain; }
  .memb__core span { font-size: 0.55rem; letter-spacing: .14em; font-weight: 900; color: #fff; }
  .memb__chips { display: flex; flex-wrap: wrap; gap: 0.4rem; justify-content: center; max-width: 320px; }
  .memb__chip { font-size: 0.66rem; font-weight: 800; letter-spacing: .06em; border-radius: 999px; padding: 0.3rem 0.7rem; background: rgba(255, 255, 255, .55); border: 1px solid #e8cf8e; color: #8a6d1a; opacity: .45; transition: all .3s; }
  .memb__chip.is-on { opacity: 1; background: #ffd12e; color: #071a31; border-color: #f7b814; box-shadow: 0 4px 14px rgba(247, 184, 20, .45); }
  .memb__panel { display: grid; gap: 0.8rem; border-radius: 1.2rem; background: #fff9eb; border: 1px solid #e8cf8e; padding: 1rem; }
  .memb__plans { display: grid; grid-template-columns: repeat(5, 1fr); gap: 0.4rem; align-items: start; }
  .memb__plan { width: 100%; border: 1px solid #e8cf8e; background: #fffdf3; border-radius: 0.8rem; padding: 0.5rem 0.4rem; cursor: pointer; text-align: center; color: #132b44; transition: all .25s; }
  .memb__plan strong { display: block; font-size: 0.78rem; letter-spacing: .05em; }
  .memb__plan b { font-size: 0.66rem; color: #8a6d1a; font-weight: 800; }
  .memb__plan[aria-pressed='true'] { background: #ffd12e; border-color: #f7b814; box-shadow: 0 6px 18px rgba(247, 184, 20, .4); }
  .memb__plan[aria-pressed='true'] b { color: #071a31; }
  .memb__plan:focus-visible, .memb__opt:focus-visible, .memb__reco-btn:focus-visible, .memb__reco-choose:focus-visible, .memb__scope summary:focus-visible, .memb__cta:focus-visible { outline: 3px solid #1655bc; outline-offset: 2px; }
  .memb__scope { font-size: 0.72rem; color: #576678; }
  .memb__scope summary { cursor: pointer; min-height: 28px; font-weight: 700; color: #1655bc; }
  .memb__scope p { margin: 6px 0 0; line-height: 1.45; }
  .memb__detail { border-top: 1px solid #f0dcae; padding-top: 0.6rem; }
  .memb__detail h3 { margin: 0; font-size: 1.15rem; color: #071a31; }
  .memb__detail > p { margin: 0.2rem 0; font-size: 0.88rem; color: #576678; line-height: 1.45; }
  .memb__price { font-weight: 900; color: #071a31 !important; font-size: 1rem !important; }
  .memb__detail ul { margin: 0.4rem 0 0; padding-left: 1.05rem; font-size: 0.8rem; color: #132b44; line-height: 1.45; display: grid; gap: 0.2rem; }
  .memb__cta { min-height: 48px; padding: 14px 22px; font-size: 16px; border-radius: 999px; text-decoration: none; display: inline-flex; align-items: center; justify-content: center; justify-self: start; background: #11274e; color: #fff; }
  .memb__diag { border-radius: 1.2rem; background: #fff9eb; border: 1px solid #e8cf8e; padding: 1rem; display: grid; gap: 0.7rem; }
  .memb__diag h3 { margin: 0; color: #071a31; font-size: 1rem; }
  .memb__diag-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 0.9rem; }
  .memb__q { display: block; font-size: 0.75rem; font-weight: 800; letter-spacing: .08em; color: #576678; margin-bottom: 0.4rem; }
  .memb__opts { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .memb__opt { border: 1px solid #e8cf8e; background: #fffdf3; color: #132b44; border-radius: 999px; padding: 0.4rem 0.8rem; font-weight: 700; font-size: 0.8rem; cursor: pointer; min-height: 48px; }
  .memb__opt[aria-pressed='true'] { background: #142c56; color: #fff; border-color: transparent; }
  .memb__reco-btn { justify-self: start; border: none; border-radius: 999px; padding: 0.6rem 1.1rem; font-weight: 900; background: #ffcc2e; color: #11274e; cursor: pointer; min-height: 48px; box-shadow: 0 4px 0 rgba(222, 152, 76, .22); }
  .memb__reco { margin: 0; font-size: 0.9rem; color: #071a31; background: #ffd12e; border-radius: 0.7rem; padding: 0.6rem 0.9rem; font-weight: 700; }
  .memb__extras { border: 1px solid #e8cf8e; background: #fff9eb; border-radius: 1.2rem; padding: 1rem; }
  .memb__extras h3 { margin: 0 0 8px; color: #071a31; font-size: 1.1rem; }
  .memb__extras p { margin: 0; max-width: 62ch; line-height: 1.55; color: #576678; font-size: 0.9rem; }
  @media (max-width: 1100px) {
    .memb__plans { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 900px) {
    .memb__grid, .memb__diag-grid { grid-template-columns: 1fr; }
    .memb__core-wrap { order: -1; }
  }
  @media (max-width: 639px) {
    .memb__plans { grid-template-columns: repeat(2, 1fr); }
  }
  @media (prefers-reduced-motion: reduce) {
    .memb__chip, .memb__core, .memb__plan { transition: none; }
  }
</style>
