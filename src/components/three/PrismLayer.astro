---
/**
 * Capa del prisma: objeto 3D persistente que acompaña el recorrido.
 * Se monta una sola vez, detrás del contenido, y cambia de orientación y
 * paleta según la ruta y el avance del scroll.
 */
---

<div class="prism-layer" aria-hidden="true">
  <canvas class="prism-layer__canvas" data-prism-canvas></canvas>
  <div class="prism-layer__fallback" data-prism-fallback>
    <svg viewBox="0 0 200 200" role="presentation" focusable="false">
      <defs>
        <linearGradient id="prism-fallback-gradient" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="var(--scene-accent)" stop-opacity="0.85" />
          <stop offset="100%" stop-color="var(--accent-strong)" stop-opacity="0.35" />
        </linearGradient>
      </defs>
      <polygon points="100,16 172,62 152,150 48,150 28,62" fill="url(#prism-fallback-gradient)" />
      <polygon points="100,16 172,62 100,92" fill="rgba(255,255,255,0.28)" />
      <polygon points="28,62 100,92 48,150" fill="rgba(255,255,255,0.12)" />
    </svg>
  </div>
</div>

<style>
  .prism-layer {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    display: grid;
    place-items: center;
    opacity: 0.9;
  }

  .prism-layer__canvas {
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 900ms var(--ease-out);
  }

  .prism-layer.is-ready .prism-layer__canvas {
    opacity: 1;
  }

  .prism-layer.is-ready .prism-layer__fallback {
    opacity: 0;
  }

  .prism-layer__fallback {
    width: min(62vmin, 520px);
    opacity: 0.85;
    transition: opacity 600ms var(--ease-out);
    filter: drop-shadow(0 30px 70px rgba(0, 0, 0, 0.6));
  }

  .prism-layer__fallback svg {
    width: 100%;
    height: auto;
  }
</style>
