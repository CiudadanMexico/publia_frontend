---
/**
 * Capa del prisma: objeto 3D persistente que acompaña el recorrido.
 * Se monta una sola vez, detrás del contenido, y cambia de orientación y
 * paleta según la ruta y el avance del scroll. Encima vive el portal
 * prismático P0-01 (solo durante transiciones hero → mundo).
 */
import PortalOverlay from './PortalOverlay.astro';
---

<div class="prism-layer" aria-hidden="true" data-load-state="loading" aria-busy="true">
  <canvas class="prism-layer__canvas" data-prism-canvas></canvas>
  <PortalOverlay />
  <div class="prism-layer__msg" data-prism-msg hidden role="status">
    <p data-prism-msg-text></p>
    <button type="button" class="prism-layer__retry" data-prism-retry>Reintentar escena</button>
  </div>
  <div class="prism-layer__fallback" data-prism-fallback>
    <svg viewBox="0 0 200 200" role="presentation" focusable="false">
      <defs>
        <linearGradient id="prism-fallback-gradient" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0%" stop-color="var(--scene-accent)" stop-opacity="0.85" />
          <stop offset="100%" stop-color="var(--accent-strong)" stop-opacity="0.35" />
        </linearGradient>
      </defs>
      <polygon points="100,16 172,62 152,150 48,150 28,62" fill="url(#prism-fallback-gradient)" />
      <polygon points="100,16 172,62 100,92" fill="rgba(255,255,255,0.28)" />
      <polygon points="28,62 100,92 48,150" fill="rgba(255,255,255,0.12)" />
    </svg>
  </div>
</div>

<style>
  .prism-layer {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    display: grid;
    place-items: center;
    opacity: 0.9;
    /* 7M-G §6: fondo base inmediato del universo (tabla hero #050b1b) */
    background: #050b1b;
  }
  .prism-layer__msg {
    position: absolute;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    display: grid;
    gap: 8px;
    justify-items: center;
    padding: 12px 18px;
    border-radius: 14px;
    background: rgba(5, 11, 27, 0.82);
    color: #f4f7ff;
    font-size: 0.85rem;
    pointer-events: auto;
  }
  .prism-layer__msg[hidden] { display: none; }
  .prism-layer__retry {
    min-height: 44px;
    border-radius: 999px;
    border: 1px solid rgba(244, 247, 255, 0.4);
    background: transparent;
    color: #f4f7ff;
    padding: 8px 16px;
    cursor: pointer;
    font-weight: 700;
  }
  .prism-layer__retry:focus-visible { outline: 3px solid #ffca34; outline-offset: 3px; }
  @media (prefers-reduced-motion: reduce) {
    .prism-layer__canvas, .prism-layer__fallback { transition: none; }
  }

  .prism-layer__canvas {
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 900ms var(--ease-out);
  }

  .prism-layer.is-ready .prism-layer__canvas {
    opacity: 1;
  }

  .prism-layer.is-ready .prism-layer__fallback {
    opacity: 0;
  }

  .prism-layer__fallback {
    width: min(62vmin, 520px);
    opacity: 0.85;
    transition: opacity 600ms var(--ease-out);
    filter: drop-shadow(0 30px 70px rgba(0, 0, 0, 0.6));
  }

  .prism-layer__fallback svg {
    width: 100%;
    height: auto;
  }
</style>
